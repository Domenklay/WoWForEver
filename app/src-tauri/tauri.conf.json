{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WoW Forever Multi",
  "version": "1.1.0",
  "identifier": "fr.forever.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WoW Forever Multi",
        "width": 1120,
        "height": 680,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "nsis",
      "dmg"
    ],
    "category": "Game",
    "shortDescription": "WoW Forever Multi client launcher",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
