 #include "PartyPackets.h"
 #include "CharacterCache.h"
+#include "ClassicOpcodes.h"
 #include "Group.h"
 #include "PacketOperators.h"
 #include "Pet.h"
@@ -47,6 +48,30 @@ WorldPacket const* PartyCommandResult::Write()
 
 void PartyInviteClient::Read()
 {
+    // Classic 1.60.1.70425+ (70450 sniff, invite from the unit menu, 23 bytes):
+    //   bits: 5 (0 in the sniff; first one assumed to be the PartyIndex flag), name length 9, surname length 9, 1 (0)
+    //   uint32 TargetRealmAddress, packed TargetGUID, name, surname, then one byte (01 in the sniff, meaning unknown)
+    // The older layout below read the 9 bit lengths 5 bits too late (length 32) and failed with a ByteBufferException.
+    if (ClassicOpcodes::IsBuild70425OrLater())
+    {
+        bool const hasPartyIndex = _worldPacket.ReadBit();
+        _worldPacket.ReadBits(4);
+        uint32 const nameLength = _worldPacket.ReadBits(9);
+        uint32 const surnameLength = _worldPacket.ReadBits(9);
+        _worldPacket.ReadBit();
+        _worldPacket >> TargetRealmAddress;
+        _worldPacket >> TargetGUID;
+        TargetName = _worldPacket.ReadString(nameLength);
+        _worldPacket.ReadString(surnameLength);
+        if (hasPartyIndex && _worldPacket.rpos() < _worldPacket.size())
+        {
+            PartyIndex.emplace();
+            _worldPacket >> *PartyIndex;
+        }
+        _worldPacket.rfinish();
+        return;
+    }
+
     _worldPacket >> OptionalInit(PartyIndex);
 
     _worldPacket.ResetBitPos();
