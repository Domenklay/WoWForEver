# Copy to .env and adjust. (No ' or " in the passwords.)

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
DB_USER=trinity
DB_PASSWORD=change-me-trinity
# SOAP admin account used by the website (created automatically)
SOAP_USER=FOREVERWEB
SOAP_PASSWORD=change-me-soap
MYSQL_BUFFER_POOL=512M

# Address the players use to reach the server:
#   127.0.0.1 = this machine only; LAN IP = local network; public IP or DNS name = internet
PUBLIC_ADDRESS=127.0.0.1
# LAN IP of the server + mask: players on this subnet get this address instead
REALM_LOCAL_ADDRESS=127.0.0.1
REALM_LOCAL_SUBNET_MASK=255.255.255.0
REALM_NAME=Forever

# Game client build. The client must be exactly World of Warcraft Forever 1.60.1.70450.
# Empty = only the build the forever branch supports.
CLIENT_BUILD=70450

# Build
TC_REF=forever
# Tested core revision for the experimental subclass adapter.
TC_COMMIT=91d49b230f89c3ab4719f5b2b2d1e70ed36613c4
# parallel compile jobs (~2 GB of RAM per job)
BUILD_JOBS=4

# Enable with scripts/subclass-mod.sh install after schema backup/migration.
SUBCLASS_ENABLED=0
# Freepick: permanent main class, simultaneous foreign skills and the Custom tab.
# install-freepick verifies the native-backed Mana Shield before completing installation.
SUBCLASS_FREEPICK=0

# Game data extraction (docker compose run --rm extractor)
# the "World of Warcraft" folder (the one holding Data and .build.info, not _classic_beta_)
WOW_DIR=/path/to/World of Warcraft
# owner of the files extracted into ./data (id -u / id -g)
HOST_UID=1000
HOST_GID=1000
# 1 = also generate mmaps (slow)
EXTRACT_MMAPS=0

# 1 = pathfinding on (needs the mmaps folder in ./data)
MMAP_PATHFINDING=0

TZ=UTC

# Website
WEB_PORT=8088
SIGNUPS_PER_IP_PER_HOUR=3
# Launcher downloads on the website (/download/<os>), first match wins:
#   1. a direct link per system
LAUNCHER_LINUX_URL=
LAUNCHER_WINDOWS_URL=
LAUNCHER_MAC_URL=
#   2. files dropped in DOWNLOADS_DIR (.exe, .AppImage, .dmg)
DOWNLOADS_DIR=./downloads
#   3. the latest GitHub release of LAUNCHER_REPO (owner/repo); a private repo needs GITHUB_TOKEN,
#      a fine-grained token with read-only access to its Contents
LAUNCHER_REPO=
GITHUB_TOKEN=

# Where the game data and the certificates live (Dokploy: ../files/data and ../files/certs)
DATA_DIR=./data
CERTS_DIR=./certs
