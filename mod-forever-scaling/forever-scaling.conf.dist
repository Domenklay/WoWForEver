# Reference defaults. Runtime values are passed to worldserver from .env via docker-compose.yml.
FOREVER_SCALING_ENABLED=0
FOREVER_SCALING_DAMAGE_GUARD=1

# Personal virtual-level XP-safe floor: virtualLevel = max(originalLevel, playerLevel + MIN_OFFSET).
FOREVER_SCALING_MIN_OFFSET=-3
FOREVER_SCALING_CREATURE_MAX_LEVEL=70

# Legacy/reserved v0.1 variables. v0.2 does not raise level by creature rank.
FOREVER_SCALING_MAX_OFFSET=10
FOREVER_SCALING_NORMAL_OFFSET=0
FOREVER_SCALING_ELITE_OFFSET=5
FOREVER_SCALING_RARE_ELITE_OFFSET=7
FOREVER_SCALING_BOSS_OFFSET=8

# Per-hit NPC -> player safety caps.
FOREVER_SCALING_CAP_NORMAL=20
FOREVER_SCALING_CAP_ELITE=30
FOREVER_SCALING_CAP_RARE_ELITE=40
FOREVER_SCALING_CAP_BOSS=45

# Opt-in classic five-person dungeons only. Requires FOREVER_SCALING_ENABLED=1.
FOREVER_DUNGEON_SCALING_ENABLED=0
